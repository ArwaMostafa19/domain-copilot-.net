# Copy to .env. Replace placeholders with local secrets; never commit .env.
# PostgreSQL 16 + pgvector
POSTGRES_USER=copilot_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=CopilotDB
APP_DB_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql://copilot_app:replace-with-app-password@db:5432/CopilotDB
ADMIN_DATABASE_URL=postgresql://copilot_admin:replace-with-admin-password@db:5432/CopilotDB
AUTH_SECRET=THIS_IS_NOT_A_SECRET_REPLACE_WITH_YOUR_OWN_RANDOM_VALUE

# Chat provider order. Hosted providers require their API key.
LLM_CHAIN=groq,gemini,ollama
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STREAM_USAGE=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_STREAM_USAGE=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Timeouts, retrieval, workflow budgets, and API settings
LLM_TIMEOUT_SECONDS=180
LLM_COOLDOWN_SECONDS=60
RETRIEVAL_MIN_SIMILARITY=0.55
RUN_MAX_MODEL_CALLS=6
RUN_TOKEN_BUDGET=20000
RUN_TIMEOUT_SECONDS=120
RUN_STEP_TIMEOUT_SECONDS=45
TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=
MAX_INGEST_FILE_BYTES=10485760
DEMO_USER_PASSWORD=


# Used by CLI login/ask; the static frontend uses the same-origin API.
API_BASE_URL=http://localhost:18080/

