<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CorpusSourceDirectory Condition="'$(CorpusSourceDirectory)' == ''">$(MSBuildThisFileDirectory)../../corpus</CorpusSourceDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DomainCopilot.Application\DomainCopilot.Application.csproj" />
    <ProjectReference Include="..\DomainCopilot.Infrastructure\DomainCopilot.Infrastructure.csproj" />
    <Content Include="static\**\*" Link="static\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(CorpusSourceDirectory)/**/*" Link="corpus/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
