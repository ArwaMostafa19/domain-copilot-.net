<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DomainCopilot.Application\DomainCopilot.Application.csproj" />
    <ProjectReference Include="..\DomainCopilot.Domain\DomainCopilot.Domain.csproj" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.23" />
    <Content Include="..\..\migrations\*.sql" Link="migrations\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
